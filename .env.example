# BloodConnect RD — Variables de entorno (ejemplo)
# Copiar a .env y ajustar valores. No subir .env al repositorio.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

POSTGRES_DB=bloodconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://postgres:5432/bloodconnect_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=CHANGE_ME_WITH_A_SECURE_SECRET_AT_LEAST_256_BITS_LONG_FOR_HS256
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# Frontend
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080

# URL pública del sitio (canonical, Open Graph, sitemap). Vacío = se usa el origen de la petición.
PUBLIC_SITE_URL=
SITE_URL=

# Hosts permitidos por el servidor SSR. * solo si un proxy valida el header Host.
NG_ALLOWED_HOSTS=*

# Verificación de Google Search Console (pegar el código cuando exista; no inventar uno).
# GOOGLE_SITE_VERIFICATION=

# Flutter (no hardcodear API keys en código)
# Android emulator: http://10.0.2.2:8080
# iOS simulator: http://localhost:8080
FLUTTER_API_BASE_URL=http://localhost:8080

# MCP (desactivado por defecto). No es autenticación OAuth 2.1 de producción.
# Ver docs/MCP.md antes de habilitarlo.
MCP_ENABLED=false
MCP_SERVER_NAME=bloodconnectrd-mcp
MCP_SERVER_VERSION=1.0.0
MCP_MAX_PAGE_SIZE=50
MCP_DEFAULT_RADIUS_KM=25
MCP_MAX_RADIUS_KM=100
MCP_RATE_LIMIT_PER_MINUTE=60

# Google Maps (móvil): no poner las keys aquí ni en Dart.
# Android: añade MAPS_API_KEY a mobile/android/local.properties
# iOS: copia mobile/ios/Flutter/Secrets.xcconfig.example → Secrets.xcconfig (MAPS_API_KEY_IOS)
# Detalle y restricciones: mobile/README.md
