// Copia este archivo como Secrets.xcconfig (no se sube a git):
//   cp ios/Flutter/Secrets.xcconfig.example ios/Flutter/Secrets.xcconfig
//
// Usa una API key de iOS distinta a la de Android, restringida al bundle
// com.bloodconnect.bloodconnectRd y a Maps SDK for iOS.

MAPS_API_KEY_IOS=YOUR_IOS_GOOGLE_MAPS_API_KEY
